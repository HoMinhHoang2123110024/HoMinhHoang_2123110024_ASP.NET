                        #results .searchSuperTop .news-supertop a:visited {color:#660099}#results #right .reg .compProductList a:visited{color:#660099}#results #cols .compTitle h3.title a:hover{color:#1a0dab !important}#results .compList a:hover, #results .compTable a:hover, #results .compDlink a:hover, #results #right .compImageList .imgbox a:hover{color:#1a0dab}#main .last .dd .compDlink a:hover, #right .last .compList a:hover, #main .searchCenterFooter .AlsoTry a:hover{color:#1a0dab}
